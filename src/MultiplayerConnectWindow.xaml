<Window x:Class="SiscoNet.MultiplayerConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to a shared topology" Width="440" Height="340" MinWidth="420" MinHeight="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WorkspaceBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Join a peer-hosted topology" FontSize="19" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Host IP address" FontWeight="SemiBold" />
            <TextBox x:Name="HostAddressBox" Text="127.0.0.1" Margin="0,5,0,10" />
            <TextBlock Text="Port" FontWeight="SemiBold" />
            <TextBox x:Name="PortBox" Text="47831" Margin="0,5,0,10" />
            <TextBlock Text="Display name" FontWeight="SemiBold" />
            <TextBox x:Name="DisplayNameBox" Margin="0,5,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,12,0,0">
            Connect directly to the host's reachable IP and port. The host must allow inbound TCP on this port. This peer mode does not use a relay or automatically traverse NAT.
        </TextBlock>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="76" />
            <Button Content="Connect" IsDefault="True" Click="Connect_Click" MinWidth="88" Background="#087E8B" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>