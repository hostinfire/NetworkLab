<Window x:Class="SiscoNet.DiscordPresenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Rich Presence" Width="520" Height="300" MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WorkspaceBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Discord Rich Presence" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,15,0,10">
            <TextBlock Text="Discord Application ID" FontWeight="SemiBold" />
            <TextBox x:Name="ApplicationIdBox" Margin="0,5,0,4" ToolTip="Numeric Application ID from the Discord Developer Portal" />
        </StackPanel>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}">
            Create an application in the Discord Developer Portal, copy its Application ID, and paste it above. Discord Desktop must be running. The ID is saved locally in your Northstar settings. Presence reports the current project and selected device; it does not send topology data.
        </TextBlock>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0">
            <Button Content="Developer Portal" Click="DeveloperPortal_Click" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Disconnect" Click="Disconnect_Click" />
                <Button Content="Cancel" IsCancel="True" />
                <Button Content="Save and connect" IsDefault="True" Click="Save_Click" Background="#087E8B" Foreground="White" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>