<Application x:Class="SiscoNet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#087E8B" />
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#F2F5F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#20292F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#63717A" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6DDE1" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CCD3D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#20292F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,3,0,8" />
            <Setter Property="BorderBrush" Value="#CCD3D8" />
        </Style>
    </Application.Resources>
</Application>