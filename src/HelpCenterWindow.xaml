<Window x:Class="SiscoNet.HelpCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northstar Network Lab Help" Height="700" Width="1020" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WorkspaceBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,10">
                <TextBlock Text="Help Center" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Guides for building, configuring, and simulating a network." Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="10" Background="{DynamicResource PanelBrush}">
            <TabItem Header="Getting started"><WebBrowser x:Name="GettingStartedBrowser" /></TabItem>
            <TabItem Header="Canvas and tools"><WebBrowser x:Name="CanvasToolsBrowser" /></TabItem>
            <TabItem Header="Devices and interfaces"><WebBrowser x:Name="DevicesBrowser" /></TabItem>
            <TabItem Header="Routing and CLI"><WebBrowser x:Name="RoutingBrowser" /></TabItem>
            <TabItem Header="Simulation and packets"><WebBrowser x:Name="SimulationBrowser" /></TabItem>
            <TabItem Header="Projects and recovery"><WebBrowser x:Name="ProjectsBrowser" /></TabItem>
            <TabItem Header="Discord presence"><WebBrowser x:Name="DiscordBrowser" /></TabItem>
            <TabItem Header="Shortcuts"><WebBrowser x:Name="ShortcutsBrowser" /></TabItem>
            <TabItem Header="Protocol scope"><WebBrowser x:Name="ProtocolScopeBrowser" /></TabItem>
            <TabItem Header="Services, wireless, and IoT"><WebBrowser x:Name="ServicesBrowser" /></TabItem>
            <TabItem Header="Multiplayer"><WebBrowser x:Name="MultiplayerBrowser" /></TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
            <TextBlock Text="Northstar Network Lab  |  Help articles are organized as tabs so additional guides can be added here." Margin="14,6" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
    </Grid>
</Window>